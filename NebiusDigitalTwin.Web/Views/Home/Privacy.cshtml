@{
    ViewData["Title"] = "Privacy Policy & Compliance";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Encabezado -->
            <div class="border-bottom pb-3 mb-4">
                <h1 class="fw-bold text-primary"><i class="bi bi-shield-lock-fill me-2"></i> Privacy Policy & Compliance</h1>
                <p class="text-muted mb-0">Last updated: September 2026 | Nebius Digital Twin Security Center</p>
            </div>

            <!-- Introducción -->
            <div class="card shadow-sm border-0 bg-light mb-4">
                <div class="card-body">
                    <h5 class="fw-bold text-dark"><i class="bi bi-info-circle me-2"></i> Commitment to Security</h5>
                    <p class="mb-0 text-secondary">
                        At <strong>Nebius Digital Twin Security Center</strong>, we take data privacy, simulation integrity, and asset confidentiality extremely seriously. This policy outlines how we handle topological telemetry, vulnerability mappings, and simulated enterprise data within our platform architecture.
                    </p>
                </div>
            </div>

            <!-- Secciones de Políticas -->
            <div class="mb-4">
                <h4 class="fw-bold text-secondary border-bottom pb-2">1. Information Collection & Telemetry</h4>
                <p class="text-secondary">
                    Our platform processes infrastructure definitions, hostnames, network zones, IP configurations, and exposed Common Vulnerabilities and Exposures (CVEs) exclusively for threat modeling and AI-driven security simulations. No real production credentials or sensitive enterprise payloads are permanently stored outside isolated simulation states.
                </p>
            </div>

            <div class="mb-4">
                <h4 class="fw-bold text-secondary border-bottom pb-2">2. AI Engine & Vulnerability Lookups</h4>
                <p class="text-secondary">
                    Queries executed through our hybrid AI vulnerability lookup engine interact securely with official threat feeds (such as NIST NVD) or localized fallback engines. Search telemetry is anonymized and utilized solely to evaluate enterprise attack surfaces and lateral movement paths.
                </p>
            </div>

            <div class="mb-4">
                <h4 class="fw-bold text-secondary border-bottom pb-2">3. Data Persistence & MongoDB Security</h4>
                <p class="text-secondary">
                    Registered assets and network topology mappings are securely persisted within structured collections managed by MongoDB context layers. Users retain full control over their simulated inventory and can wipe or modify active assets dynamically using administrative dashboard controls.
                </p>
            </div>

            
            <div class="mb-4">
                <h4 class="fw-bold text-secondary border-bottom pb-2">4. Intellectual Property & Copyright</h4>
                <p class="text-secondary">
                    © 2026 <strong>Nebius Digital Twin Security Center</strong>. Developed by <strong>Johann Arley Cruz Méndez</strong>. All rights reserved. The architecture, user interface design, simulation algorithms, and topological mapping engines are proprietary components developed for enterprise security analysis and advanced threat intelligence evaluation.
                </p>
            </div>

            <!-- Botón de Retorno -->
            <div class="text-center mt-5">
                <a href="/" class="btn btn-primary fw-bold px-4">
                    <i class="bi bi-house-door me-2"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
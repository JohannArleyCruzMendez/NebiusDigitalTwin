@{
    ViewData["Title"] = "Threat Simulation";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-shield-lock"></i> Digital Twin Security Center</h2>

    <!-- Panel de Guía Rápida e Instructivo (User Guide) -->
    <div class="card shadow-sm border-info mb-4">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#collapseGuia" role="button" aria-expanded="false" aria-controls="collapseGuia" style="cursor: pointer;">
            <h5 class="card-title mb-0">
                <i class="bi bi-info-circle me-2"></i> User Guide & Asset Reference (Click to Expand)
            </h5>
            <i class="bi bi-chevron-down"></i>
        </div>
        <div class="collapse" id="collapseGuia">
            <div class="card-body bg-light">
                <div class="row">
                    <!-- Columna 1: Registro de Activos -->
                    <div class="col-md-6 border-end">
                        <h6 class="text-primary fw-bold mb-3"><i class="bi bi-hdd-rack me-1"></i> 1. Register New Asset (Digital Twin)</h6>
                        <p class="small text-muted mb-2">Build the digital twin by recording your infrastructure components:</p>
                        <ul class="small mb-0">
                            <li><strong>Hostname:</strong> Unique identifier for the server or device (e.g., <code>App-Backend-01</code>).</li>
                            <li><strong>Asset Type & Criticality:</strong> Defines the logical role and criticality level. Assets marked as <em>High</em> are automatically rendered in bright red on the network map.</li>
                            <li><strong>IPs & System:</strong> Network addresses and operating system (e.g., <code>Ubuntu 22.04</code>), used by the AI to correlate architecture.</li>
                            <li><strong>Security Posture & CVEs:</strong> Enables options like root SSH access or registering known vulnerabilities (e.g., <code>CVE-2022-34716</code>) so the AI can detect real attack vectors.</li>
                        </ul>
                    </div>

                    <!-- Columna 2: Simulación de IA -->
                    <div class="col-md-6">
                        <h6 class="text-danger fw-bold mb-3"><i class="bi bi-robot me-1"></i> 2. Run Threat Simulation (AI Engine)</h6>
                        <p class="small text-muted mb-2">Simulate advanced security incidents over your current topology:</p>
                        <ul class="small mb-3">
                            <li><strong>Threat Vector:</strong> Describe in natural language the attack scenario you want to evaluate.</li>
                            <li>
                                <strong>Recommended test example:</strong>
                                <code class="d-block bg-white p-2 border rounded mt-1 text-dark">Lateral movement attack exploiting the web backend to reach the core database</code>
                            </li>
                        </ul>
                        <p class="small text-muted mb-0">
                            <i class="bi bi-lightbulb text-warning"></i> <strong>Expected Outcome:</strong> The AI analyzes real-time connections, vulnerabilities, and data criticality to generate a report detailing risk levels, attack paths, and mitigations.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <!-- Botón para ir al mapa interactivo -->
        <a href="/Nodos/NetworkMap" class="btn btn-success fw-bold shadow-sm">
            <i class="bi bi-diagram-3 me-2"></i> View Network Topology Map
        </a>
    </div>

    <div class="row">
        <!-- Panel Izquierdo: Controles, Registro e Inventario -->
        <div class="col-md-5">

            <!-- Tarjeta 1: Simulación -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="card-title mb-0">Run Threat Simulation</h5>
                </div>
                <div class="card-body">
                    <form id="simulacionForm">
                        <div class="mb-3">
                            <label class="form-label">Threat Vector / Attack Scenario:</label>
                            <input type="text" id="amenazaObjetivo" class="form-control" placeholder="e.g. DDoS Attack, Ransomware...">
                        </div>
                        <button type="button" class="btn btn-danger w-100" onclick="ejecutarSimulacion()">
                            Execute AI Analysis
                        </button>
                    </form>
                </div>
            </div>

            <!-- Tarjeta 2: Registro de Nodo -->
            <div class="card shadow-sm border-primary mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0"><i class="bi bi-hdd-network"></i> Register New Asset</h5>
                </div>
                <div class="card-body bg-light">
                    <form id="crearNodoForm">
                        <div class="row">
                            <!-- Columna Izquierda: Información General -->
                            <div class="col-md-6">
                                <h6 class="text-primary border-bottom pb-2 mb-3">General Info</h6>

                                <div class="mb-2">
                                    <label class="form-label fw-bold small">Hostname:</label>
                                    <input type="text" id="nodoNombre" class="form-control form-control-sm" placeholder="e.g. WebServer-01">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small mb-0">Asset Type:</label>
                                    <select id="selectAssetType" name="assetType" class="form-select form-select-sm" onchange="checkCustomAssetType(this)">
                                        <option value="" selected disabled>Select asset infrastructure type...</option>
                                        <optgroup label="Network & Perimeter">
                                            <option value="Firewall">Firewall</option>
                                            <option value="Gateway">Gateway</option>
                                            <option value="Router">Router</option>
                                            <option value="Switch">Switch</option>
                                            <option value="Load Balancer">Load Balancer</option>
                                        </optgroup>
                                        <optgroup label="Wireless & IoT Peripherals">
                                            <option value="Wireless Access Point (AP)">Wireless Access Point (AP)</option>
                                            <option value="Network Printer">Network Printer / MFP</option>
                                            <option value="IP Camera / IoT Sensor">IP Camera / IoT Sensor</option>
                                            <option value="SCADA / Industrial Controller">SCADA / Industrial Controller</option>
                                        </optgroup>
                                        <optgroup label="Servers & Compute">
                                            <option value="App Backend Server">App Backend Server</option>
                                            <option value="Web Frontend Server">Web Frontend Server</option>
                                            <option value="Database Server">Database Server</option>
                                            <option value="Domain Controller">Domain Controller (AD)</option>
                                        </optgroup>
                                        <optgroup label="Storage & Endpoints">
                                            <option value="File Server">File Server</option>
                                            <option value="Network Attached Storage (NAS)">Network Attached Storage (NAS)</option>
                                            <option value="Backup Server">Backup Server</option>
                                            <option value="Workstation / Endpoint">Workstation / Endpoint</option>
                                        </optgroup>
                                        <optgroup label="Custom">
                                            <option value="Other">Other (Custom Device)</option>
                                        </optgroup>
                                    </select>
                                </div>

                                <!-- Input dinámico que aparece solo si seleccionan "Other" -->
                                <div class="mb-3 d-none" id="customAssetDiv">
                                    <label class="form-label fw-bold small text-muted mb-0">Specify Custom Device Name:</label>
                                    <input type="text" id="inputCustomAsset" name="customAssetType" class="form-control form-control-sm" placeholder="e.g. Mainframe, Main Gate Sensor, Proxy Cache...">
                                </div>

                                <div class="mb-2">
                                    <label class="form-label fw-bold small">Asset Criticality:</label>
                                    <select id="nodoCriticidad" class="form-select form-select-sm">
                                        <option value="High">High (Mission Critical)</option>
                                        <option value="Medium" selected>Medium (Standard)</option>
                                        <option value="Low">Low (Internal Use)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Columna Derecha: Sistema y Red -->
                            <div class="col-md-6">
                                <h6 class="text-primary border-bottom pb-2 mb-3">System & Network</h6>

                                <div class="mb-2">
                                    <label class="form-label fw-bold small">Main IP Address:</label>
                                    <input type="text" id="nodoIp" class="form-control form-control-sm" placeholder="e.g. 192.168.1.50">
                                </div>

                                <div class="row">
                                    <div class="col-6 mb-2">
                                        <label class="form-label fw-bold small">Private IP:</label>
                                        <input type="text" id="nodoIpPrivada" class="form-control form-control-sm" placeholder="10.0.x.x">
                                    </div>
                                    <div class="col-6 mb-2">
                                        <label class="form-label fw-bold small">Public IP:</label>
                                        <input type="text" id="nodoIpPublica" class="form-control form-control-sm" placeholder="203.0.x.x">
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label fw-bold small">Operating System:</label>
                                    <input type="text" id="nodoSO" class="form-control form-control-sm" placeholder="e.g. Ubuntu 22.04 LTS">
                                </div>

                                <div class="mb-2">
                                    <label class="form-label fw-bold small">Kernel Version:</label>
                                    <input type="text" id="nodoKernel" class="form-control form-control-sm" placeholder="e.g. 5.15.0-76">
                                </div>
                            </div>
                        </div>

                        <!-- Fila Inferior: Seguridad -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h6 class="text-primary border-bottom pb-2 mb-3">Security Posture</h6>

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <div class="form-check form-switch mt-2">
                                            <input class="form-check-input" type="checkbox" id="nodoRootSSH">
                                            <label class="form-check-label small fw-bold text-danger" for="nodoRootSSH">Allows Root SSH</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check form-switch mt-2">
                                            <input class="form-check-input" type="checkbox" id="nodoDatosSensibles">
                                            <label class="form-check-label small fw-bold text-warning" for="nodoDatosSensibles">Stores Sensitive Data</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label fw-bold small">Exposed Services (comma separated):</label>
                                    <input type="text" id="nodoServicios" class="form-control form-control-sm" placeholder="e.g. Nginx, SSH, MySQL">
                                </div>

                                <!-- Seccion Known CVEs con Asistente IA Integrado -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label fw-bold small mb-0">Known CVEs (comma separated):</label>
                                        <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 small" data-bs-toggle="collapse" data-bs-target="#cveAiAssistantPanel">
                                            <i class="bi bi-stars me-1"></i> AI CVE Lookup
                                        </button>
                                    </div>

                                    <!-- Panel Asistente en Línea (Colapsable) -->
                                    <div class="collapse mb-2" id="cveAiAssistantPanel">
                                        <div class="card card-body bg-light border-primary p-2">
                                            <label class="small text-muted fw-bold mb-1">Describe the software, version, or flaw in natural language:</label>
                                            <div class="input-group input-group-sm mb-2">
                                                <input type="text" id="aiCvePrompt" class="form-control" placeholder="e.g. OpenSSL 3.0 buffer overflow, Log4j RCE, Spring4Shell...">
                                                <button type="button" class="btn btn-primary" onclick="lookupCveWithAI()">
                                                    <i class="bi bi-search me-1"></i> Query AI
                                                </button>
                                            </div>
                                            <!-- Contenedor del Resultado -->
                                            <div id="aiCveResult" class="small d-none">
                                                <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded border">
                                                    <span id="aiCveDetails" class="text-dark"></span>
                                                    <button type="button" class="btn btn-success btn-sm py-0 ms-2" onclick="insertCveToForm()">
                                                        <i class="bi bi-plus-lg me-1"></i> Add to Form
                                                    </button>
                                                </div>
                                            </div>
                                            <div id="aiCveLoading" class="text-muted small text-center py-1 d-none">
                                                <div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div>
                                                Analyzing vulnerability database...
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Input principal de CVEs -->
                                    <input type="text" id="inputCves" name="cves" class="form-control form-control-sm" placeholder="e.g. CVE-2021-44228, CVE-2022-34716">
                                </div>
                            </div>
                        </div>

                        <button type="button" class="btn btn-primary w-100 fw-bold mt-2" onclick="guardarNodo()">
                            <i class="bi bi-cloud-upload me-2"></i> Deploy to Digital Twin
                        </button>
                    </form>
                    <div id="mensajeNodo" class="mt-3 text-center"></div>
                </div>
            </div>

            <!-- Tarjeta 3: Inventario de Nodos -->
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0"><i class="bi bi-server"></i> Active Assets</h5>
                    <button class="btn btn-sm btn-light" onclick="cargarNodos()">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Hostname</th>
                                    <th>IP</th>
                                    <th>Type</th>
                                    <th>Crit.</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="tablaNodosBody">
                                <tr><td colspan="5" class="text-center text-muted py-3">Loading inventory...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

        
        <!-- Panel Derecho: Resultados -->
       
        <div class="col-md-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Nemotron Security Report</h5>
                    <!-- Distintivo dinámico manejado por JavaScript -->
                    <span id="badgeProveedor" class="badge bg-secondary">Awaiting...</span>
                </div>
                <div class="card-body" id="resultadoSimulacion">
                    <p class="text-muted text-center mt-5">Awaiting simulation trigger...</p>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script type="text/javascript" src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
    <script>
        
                async function ejecutarSimulacion() {
            const amenaza = document.getElementById('amenazaObjetivo').value;
            const contenedorResultado = document.getElementById('resultadoSimulacion');
            const boton = document.querySelector('#simulacionForm button');

            if (!amenaza) {
                alert('Please enter a threat vector.');
                return;
            }

            boton.disabled = true;
            boton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Analyzing...';
            contenedorResultado.innerHTML = '<div class="text-center mt-5"><div class="spinner-grow text-danger" role="status"></div><p class="mt-2 text-muted">Consulting LLM model...</p></div>';

            try {
                const payload = { AmenazaObjetivo: amenaza };

                const response = await fetch('https://localhost:7263/api/v1/Nodos/simular', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    const reporte = await response.json();

                    // --- ACTUALIZACIÓN DINÁMICA DEL BADGE DEL PROVEEDOR ---
                    const badge = document.getElementById('badgeProveedor');
                    const proveedor = reporte.proveedorUtilizado || "Nebius Token Factory";

                    badge.textContent = proveedor;
                    if (proveedor.includes("Nebius")) {
                        badge.className = "badge bg-success";
                    } else {
                        badge.className = "badge bg-warning text-dark";
                    }
                    // ------------------------------------------------------

                    let html = `
                        <div class="alert alert-danger">
                            <h4 class="alert-heading">Risk Level: ${reporte.nivelRiesgoGlobal}</h4>
                            <hr>
                            <p class="mb-0">${reporte.resumenEjecutivo}</p>
                        </div>
                        <h6 class="mt-4 fw-bold">Possible Attack Paths:</h6>
                        <ul class="list-group list-group-flush mb-4">
                            ${reporte.rutasAtaquePosibles.map(ruta => `<li class="list-group-item"><i class="bi bi-bug text-danger me-2"></i>${ruta}</li>`).join('')}
                        </ul>
                        <h6 class="fw-bold">Recommended Mitigations:</h6>
                        <ul class="list-group list-group-flush">
                            ${reporte.mitigacionesRecomendadas.map(mitigacion => `<li class="list-group-item bg-light"><i class="bi bi-shield-check text-success me-2"></i>${mitigacion}</li>`).join('')}
                        </ul>
                    `;
                    contenedorResultado.innerHTML = html;
                } else {
                    const errorDetails = await response.text();
                    contenedorResultado.innerHTML = `<div class="alert alert-warning"><strong>HTTP Error ${response.status}:</strong> <br> ${errorDetails}</div>`;
                }
            } catch (error) {
                contenedorResultado.innerHTML = `<div class="alert alert-danger">Network Error: ${error.message}</div>`;
            } finally {
                boton.disabled = false;
                boton.innerHTML = 'Execute AI Analysis';
            }
        }


            async function guardarNodo() {
            const mensajeDiv = document.getElementById('mensajeNodo');
            const botonGuardar = document.querySelector('#crearNodoForm button');

            mensajeDiv.innerHTML = '';

            // Obtenemos los valores asegurando un respaldo por defecto si están vacíos
            const nombre = document.getElementById('nodoNombre').value.trim();
            const ip = document.getElementById('nodoIp').value.trim() || "192.168.1.100";
            const so = document.getElementById('nodoSO').value.trim() || "Generic OS";

            const selectTypeElement = document.getElementById('selectAssetType');
            let tipo = selectTypeElement ? selectTypeElement.value : "";

            // Si no seleccionó nada o eligió "Other", manejamos el valor personalizado
            if (!tipo || tipo === 'Other') {
                const customVal = document.getElementById('inputCustomAsset').value.trim();
                tipo = customVal ? `Custom: ${customVal}` : (tipo || "Standard Device");
            }

            const criticidad = document.getElementById('nodoCriticidad').value;
            const kernel = document.getElementById('nodoKernel').value.trim() || "N/A";

            const ipPrivada = document.getElementById('nodoIpPrivada').value.trim() || "";
            const ipPublica = document.getElementById('nodoIpPublica').value.trim() || "";
            const permiteRootSSH = document.getElementById('nodoRootSSH').checked;
            const almacenaDatos = document.getElementById('nodoDatosSensibles').checked;

            const serviciosInput = document.getElementById('nodoServicios').value;
            const cvesInput = document.getElementById('inputCves').value;

            // Validación simplificada: solo exigimos el Nombre del host
            if (!nombre) {
                mensajeDiv.innerHTML = '<span class="text-danger small">Please enter at least the Hostname.</span>';
                return;
            }

            const serviciosArray = serviciosInput.split(',').map(s => s.trim()).filter(s => s !== "");
            const cvesArray = cvesInput.split(',').map(s => s.trim()).filter(s => s !== "");

            const payload = {
                Nodo: {
                    Nombre: nombre,
                    Tipo: tipo,
                    SistemaOperativo: so,
                    VersionKernel: kernel,
                    CriticidadActivo: criticidad,
                    Red: {
                        DireccionIp: ip,
                        IpPrivada: ipPrivada,
                        IpPublica: ipPublica
                    },
                    Seguridad: {
                        ServiciosExpuestos: serviciosArray,
                        Vulnerabilidades: cvesArray,
                        PermiteRootSSH: permiteRootSSH,
                        AlmacenaDatosSensibles: almacenaDatos
                    },
                    ConexionesSalientes: []
                }
            };

            botonGuardar.disabled = true;
            mensajeDiv.innerHTML = '<span class="text-info small"><i class="spinner-border spinner-border-sm"></i> Saving to MongoDB...</span>';

            try {
                const response = await fetch('https://localhost:7263/api/v1/Nodos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    mensajeDiv.innerHTML = '<span class="text-success fw-bold small"><i class="bi bi-check-circle"></i> Asset successfully registered!</span>';
                    document.getElementById('crearNodoForm').reset();
                    document.getElementById('customAssetDiv').classList.add('d-none');
                    cargarNodos();
                } else {
                    const error = await response.text();
                    mensajeDiv.innerHTML = `<span class="text-danger small">Error: ${error}</span>`;
                }
            } catch (error) {
                mensajeDiv.innerHTML = `<span class="text-danger small">Network Error: ${error.message}</span>`;
            } finally {
                botonGuardar.disabled = false;
            }
        }



           


















        async function cargarNodos() {
            const tbody = document.getElementById('tablaNodosBody');
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Loading inventory...</td></tr>';

            try {
                const response = await fetch('https://localhost:7263/api/v1/Nodos');

                if (response.ok) {
                    const nodos = await response.json();

                    if (nodos.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No assets deployed yet.</td></tr>';
                        return;
                    }

                    let html = '';
                    nodos.forEach(n => {
                        const ip = n.red && n.red.direccionIp ? n.red.direccionIp : 'N/A';

                        let critBadge = 'bg-secondary';
                        if(n.criticidadActivo === 'High') critBadge = 'bg-danger';
                        if(n.criticidadActivo === 'Medium') critBadge = 'bg-warning text-dark';
                        if(n.criticidadActivo === 'Low') critBadge = 'bg-success';
                        html += `
                            <tr>
                                <td class="fw-bold small align-middle">${n.nombre}</td>
                                <td class="small align-middle">${ip}</td>
                                <td class="small align-middle">${n.tipo || 'N/A'}</td>
                                <td class="align-middle"><span class="badge ${critBadge}">${n.criticidadActivo || 'N/A'}</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger" onclick="eliminarNodo('${n.id}')" title="Delete Asset">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        `;
                    });

                    tbody.innerHTML = html;
                } else {
                    tbody.innerHTML = `<tr><td colspan="5" class="text-danger text-center">Failed to load: HTTP ${response.status}</td></tr>`;
                }
            } catch (error) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-danger text-center">Network Error: ${error.message}</td></tr>`;
            }
        }

        async function eliminarNodo(id) {
            if (!confirm('Are you sure you want to delete this asset from the Digital Twin?')) {
                return;
            }

            try {
                const response = await fetch(`https://localhost:7263/api/v1/Nodos/${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    cargarNodos();
                } else {
                    const error = await response.text();
                    alert(`Failed to delete asset: ${error}`);
                }
            } catch (error) {
                alert(`Network Error: ${error.message}`);
            }
        }

        document.addEventListener('DOMContentLoaded', cargarNodos);

        let detectedCveCode = '';

        async function lookupCveWithAI() {
            const promptInput = document.getElementById('aiCvePrompt').value.trim();
            const resultDiv = document.getElementById('aiCveResult');
            const loadingDiv = document.getElementById('aiCveLoading');
            const detailsSpan = document.getElementById('aiCveDetails');

            if (!promptInput) {
                alert('Please specify the software or vulnerability description.');
                return;
            }

            loadingDiv.classList.remove('d-none');
            resultDiv.classList.add('d-none');

            try {
                const response = await fetch('https://localhost:7263/api/v1/Nodos/consultar-cve', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query: promptInput })
                });

                if (response.ok) {
                    const data = await response.json();
                    detectedCveCode = data.cveCode;
                    detailsSpan.innerHTML = `<strong>${data.cveCode}</strong>: ${data.description}`;
                    resultDiv.classList.remove('d-none');
                } else {
                    mockCveResponse(promptInput, detailsSpan, resultDiv);
                }
            } catch (error) {
                mockCveResponse(promptInput, detailsSpan, resultDiv);
            } finally {
                loadingDiv.classList.add('d-none');
            }
        }

        function insertCveToForm() {
            if (!detectedCveCode) return;

            const inputCves = document.getElementById('inputCves');
            const currentVal = inputCves.value.trim();

            if (currentVal.length === 0) {
                inputCves.value = detectedCveCode;
            } else if (!currentVal.includes(detectedCveCode)) {
                inputCves.value = `${currentVal}, ${detectedCveCode}`;
            }

            const collapseElement = document.getElementById('cveAiAssistantPanel');
            const bsCollapse = bootstrap.Collapse.getInstance(collapseElement);
            if (bsCollapse) bsCollapse.hide();

            document.getElementById('aiCvePrompt').value = '';
            document.getElementById('aiCveResult').classList.add('d-none');
        }

        function mockCveResponse(prompt, detailsSpan, resultDiv) {
            const p = prompt.toLowerCase();
            let code = "CVE-2023-38606";
            let desc = "Remote privilege escalation vulnerability.";

            if (p.includes("log4j") || p.includes("log4shell")) {
                code = "CVE-2021-44228";
                desc = "Apache Log4j2 JNDI Remote Code Execution.";
            } else if (p.includes("openssl")) {
                code = "CVE-2022-3786";
                desc = "OpenSSL X.509 buffer overrun vulnerability.";
            } else if (p.includes("postgres") || p.includes("sql")) {
                code = "CVE-2023-39417";
                desc = "PostgreSQL extension SQL injection vulnerability.";
            } else if (p.includes("redis")) {
                code = "CVE-2023-0567";
                desc = "Redis Server Buffer Overflow / Privilege Escalation.";
            }

            detectedCveCode = code;
            detailsSpan.innerHTML = `<span class="badge bg-danger me-1">${code}</span> ${desc}`;
            resultDiv.classList.remove('d-none');
        }

        function checkCustomAssetType(selectElement) {
            const customDiv = document.getElementById('customAssetDiv');
            if (selectElement.value === 'Other') {
                customDiv.classList.remove('d-none');
                document.getElementById('inputCustomAsset').focus();
            } else {
                customDiv.classList.add('d-none');
                document.getElementById('inputCustomAsset').value = '';
            }
        }
    </script>
}
